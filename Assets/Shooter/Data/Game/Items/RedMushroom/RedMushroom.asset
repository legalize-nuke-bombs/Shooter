    \u0441\u0432\u0435\u0442. \u041E\u0431\u044B\u0447\u043D\u043E \u0440\u0430\u0441\u0442\u0435\u0442
    \u0443 \u043A\u043E\u0440\u043D\u0435\u0439 \u0441\u0442\u0430\u0440\u044B\u0445
    \u0434\u0435\u0440\u0435\u0432\u044C\u0435\u0432 \u0438\u043B\u0438 \u0432 \u0441\u044B\u0440\u044B\u0445
    \u043D\u0438\u0437\u0438\u043D\u0430\u0445. \u0412\u044B\u0433\u043B\u044F\u0434\u0438\u0442
    \u043E\u043F\u0430\u0441\u043D\u043E, \u043D\u043E \u0441\u044A\u0435\u0434\u043E\u0431\u0435\u043D."
