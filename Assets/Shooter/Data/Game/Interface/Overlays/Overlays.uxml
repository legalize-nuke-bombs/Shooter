<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Overlays.uss"/>
    <ui:VisualElement name="overlays" class="overlays" picking-mode="Ignore">
        <ui:Label name="target-name" class="line target" picking-mode="Ignore"/>
        <ui:Label name="hint" class="line hint" picking-mode="Ignore"/>
        <ui:VisualElement name="crosshair" class="crosshair" picking-mode="Ignore">
            <ui:VisualElement class="crosshair__bar crosshair__bar--up" picking-mode="Ignore"/>
            <ui:VisualElement class="crosshair__bar crosshair__bar--down" picking-mode="Ignore"/>
            <ui:VisualElement class="crosshair__bar crosshair__bar--left" picking-mode="Ignore"/>
            <ui:VisualElement class="crosshair__bar crosshair__bar--right" picking-mode="Ignore"/>
        </ui:VisualElement>
        <ui:VisualElement name="health" class="bar" picking-mode="Ignore">
            <ui:VisualElement name="health-fill" class="bar__fill" picking-mode="Ignore"/>
        </ui:VisualElement>
        <ui:VisualElement name="stamina" class="bar bar--stamina" picking-mode="Ignore">
            <ui:VisualElement name="stamina-fill" class="bar__fill bar__fill--stamina" picking-mode="Ignore"/>
        </ui:VisualElement>
        <ui:VisualElement name="hunger" class="hunger" picking-mode="Ignore">
            <ui:VisualElement name="hunger-glyph" class="hunger__glyph" picking-mode="Ignore"/>
            <ui:Label name="hunger-amount" class="hunger__amount" picking-mode="Ignore"/>
        </ui:VisualElement>
        <ui:VisualElement name="ammo" class="ammo" picking-mode="Ignore">
            <ui:Label name="ammo-magazine" class="ammo__magazine" picking-mode="Ignore"/>
            <ui:Label name="ammo-reserve" class="ammo__reserve" picking-mode="Ignore"/>
        </ui:VisualElement>
        <ui:VisualElement name="inventory-screen" class="screen">
          <ui:VisualElement class="inventory__row">
            <ui:VisualElement class="inventory">
                <ui:Label text="Руки" class="section__title" picking-mode="Ignore"/>
                <ui:VisualElement name="inventory-held" class="inventory__grid inventory__grid--hands"/>
                <ui:VisualElement name="inventory-artifacts-section">
                    <ui:Label name="inventory-artifacts-title" text="Артефакты" class="section__title" picking-mode="Ignore"/>
                    <ui:VisualElement name="inventory-artifacts" class="inventory__grid inventory__grid--artifacts"/>
                </ui:VisualElement>
                <ui:Label text="Сумка" class="section__title" picking-mode="Ignore"/>
                <ui:ScrollView name="inventory-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" class="inventory__scroll">
                    <ui:VisualElement name="inventory-grid" class="inventory__grid"/>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="inventory-side" class="inventory__side">
                <ui:VisualElement class="craft">
                    <ui:Label text="Верстак" class="section__title" picking-mode="Ignore"/>
                    <ui:VisualElement class="craft__body">
                        <ui:VisualElement name="craft-grid" class="craft__grid"/>
                        <ui:Label text="→" class="craft__arrow" picking-mode="Ignore"/>
                        <ui:VisualElement name="craft-output" class="craft__output"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="give" class="give">
                    <ui:Label name="give-title" class="line give__title" picking-mode="Ignore"/>
                    <ui:VisualElement name="give-grid" class="give__grid"/>
                    <ui:Button name="give-button" text="Отдать" class="give__button"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="loot" class="inventory loot">
                <ui:VisualElement class="loot__header">
                    <ui:Label name="loot-title" class="line loot__title" picking-mode="Ignore"/>
                    <ui:Button name="loot-take-all" text="Взять всё" class="loot__button"/>
                </ui:VisualElement>
                <ui:ScrollView name="loot-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" class="loot__scroll">
                    <ui:VisualElement name="loot-grid" class="inventory__grid"/>
                </ui:ScrollView>
            </ui:VisualElement>
          </ui:VisualElement>
          <ui:VisualElement name="item-tooltip" class="tooltip" picking-mode="Ignore">
              <ui:Label name="item-tooltip-title" class="tooltip__title" picking-mode="Ignore"/>
              <ui:Label name="item-tooltip-description" class="tooltip__description" picking-mode="Ignore"/>
              <ui:VisualElement name="item-tooltip-stats" class="tooltip__stats" picking-mode="Ignore"/>
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="talk" class="talk">
            <ui:Label name="talk-name" class="line talk__name" picking-mode="Ignore"/>
            <ui:ScrollView name="talk-log" class="talk__log"/>
            <ui:Label name="talk-waiting" text="Думает..." class="line talk__waiting" picking-mode="Ignore"/>
            <ui:TextField name="talk-input" class="talk__input"/>
            <ui:VisualElement class="talk__footer">
                <ui:Button name="talk-give" text="Передать" class="talk__give"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="radio" class="radio">
            <ui:VisualElement class="radio__panel">
                <ui:Label text="Рация" class="line radio__title" picking-mode="Ignore"/>
                <ui:ScrollView name="radio-list" class="radio__list"/>
                <ui:Label name="radio-empty" text="Никого" class="line radio__empty" picking-mode="Ignore"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="toasts" class="toasts" picking-mode="Ignore"/>
        <ui:VisualElement name="sleep" class="sleep" picking-mode="Ignore"/>
        <ui:VisualElement name="pause" class="pause">
            <ui:VisualElement class="pause__panel">
                <ui:Button name="pause-resume" text="Продолжить игру" class="pause__item"/>
                <ui:Button name="pause-save" text="Сохранить игру" class="pause__item"/>
                <ui:Button name="pause-invite" text="Пригласить игроков" class="pause__item"/>
                <ui:Button name="pause-leave" text="Сохранить и выйти" class="pause__item"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="invite" class="pause">
            <ui:VisualElement class="pause__panel">
                <ui:Label text="Пригласить игроков" class="invite__title"/>
                <ui:TextField name="invite-address" label="Адрес" class="invite__field"/>
                <ui:TextField name="invite-port" label="Порт" is-delayed="true" class="invite__field"/>
                <ui:Label name="invite-status" class="invite__status"/>
                <ui:VisualElement class="invite__actions">
                    <ui:Button name="invite-back" text="Назад" class="invite__button"/>
                    <ui:Button name="invite-copy" text="Скопировать ссылку" class="invite__button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="versions" class="corner" picking-mode="Ignore">
            <ui:Label name="clock" class="line corner__line"/>
            <ui:Label name="debug" class="line corner__line debug" picking-mode="Ignore"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
