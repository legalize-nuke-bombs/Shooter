<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Label text="Настройки клиента" class="screen__title"/>
    <ui:ScrollView mode="Vertical" horizontal-scroller-visibility="Hidden" class="screen__body">
        <ui:Label text="Звук" class="screen__section screen__section--first"/>
        <ui:Slider label="Общая громкость" low-value="0" high-value="1" fill="true" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Client.Master" binding-mode="TwoWay"/>
            </Bindings>
        </ui:Slider>
        <ui:Slider label="Музыка" low-value="0" high-value="1" fill="true" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Client.Music" binding-mode="TwoWay"/>
            </Bindings>
        </ui:Slider>
        <ui:Slider label="Окружение" low-value="0" high-value="1" fill="true" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Client.Ambience" binding-mode="TwoWay"/>
            </Bindings>
        </ui:Slider>
        <ui:Slider label="Звуки" low-value="0" high-value="1" fill="true" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Client.Sounds" binding-mode="TwoWay"/>
            </Bindings>
        </ui:Slider>
        <ui:Label text="Изображение" class="screen__section"/>
        <ui:DropdownField name="screen-resolution" label="Разрешение экрана" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Client.ScreenResolution" binding-mode="TwoWay"/>
            </Bindings>
        </ui:DropdownField>
        <ui:DropdownField name="upscaler" label="Масштабирование" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Client.Upscaler" binding-mode="TwoWay"/>
            </Bindings>
        </ui:DropdownField>
        <ui:DropdownField name="render-scale" label="Разрешение рендера" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Client.RenderScale" binding-mode="TwoWay"/>
            </Bindings>
        </ui:DropdownField>
        <ui:DropdownField name="antialiasing" label="Сглаживание" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Client.Antialiasing" binding-mode="TwoWay"/>
            </Bindings>
        </ui:DropdownField>
        <ui:DropdownField name="fog" label="Туман" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Client.Fog" binding-mode="TwoWay"/>
            </Bindings>
        </ui:DropdownField>
        <ui:Label text="Трассировка лучей (экспериментально)" class="screen__section"/>
        <ui:DropdownField name="ray-traced-global-illumination" label="Глобальное освещение" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Client.RayTracedGlobalIllumination" binding-mode="TwoWay"/>
            </Bindings>
        </ui:DropdownField>
        <ui:DropdownField name="ray-traced-reflections" label="Отражения" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Client.RayTracedReflections" binding-mode="TwoWay"/>
            </Bindings>
        </ui:DropdownField>
        <ui:DropdownField name="ray-traced-ambient-occlusion" label="Затенение" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Client.RayTracedAmbientOcclusion" binding-mode="TwoWay"/>
            </Bindings>
        </ui:DropdownField>
        <ui:DropdownField name="ray-traced-sun-shadows" label="Тени солнца" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Client.RayTracedSunShadows" binding-mode="TwoWay"/>
            </Bindings>
        </ui:DropdownField>
        <ui:DropdownField name="ray-traced-lamp-shadows" label="Тени ламп" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Client.RayTracedLampShadows" binding-mode="TwoWay"/>
            </Bindings>
        </ui:DropdownField>
        <ui:DropdownField name="ray-traced-subsurface-scattering" label="Рассеяние в коже" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Client.RayTracedSubsurfaceScattering" binding-mode="TwoWay"/>
            </Bindings>
        </ui:DropdownField>
        <ui:DropdownField name="recursive-rendering" label="Стекло и прозрачное" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Client.RecursiveRendering" binding-mode="TwoWay"/>
            </Bindings>
        </ui:DropdownField>
        <ui:DropdownField name="path-tracing" label="Трассировка пути" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Client.PathTracing" binding-mode="TwoWay"/>
            </Bindings>
        </ui:DropdownField>
    </ui:ScrollView>
    <ui:VisualElement class="screen__footer">
        <ui:Button name="back" text="Назад" class="action"/>
    </ui:VisualElement>
</ui:UXML>
