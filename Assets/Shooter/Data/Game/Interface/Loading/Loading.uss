.line {
    color: rgb(255, 255, 255);
    font-size: 13px;
}

.loading {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    justify-content: center;
    align-items: center;
}

.loading__status {
    font-size: 30px;
    color: var(--color-text);
    -unity-font-definition: url("../Overlays/RobotoMono-Regular.ttf");
}

.loading__cancel {
    margin-top: var(--space-6);
    padding: 10px 18px;
    border-width: 1px;
    border-color: var(--color-line-strong);
    -unity-text-align: middle-center;
}

.loading__cancel:hover {
    border-color: var(--color-text);
}

.loading__tip {
    position: absolute;
    right: var(--space-6);
    bottom: var(--space-6);
    max-width: 360px;
    white-space: normal;
    -unity-text-align: middle-right;
    font-size: var(--text-small);
    color: var(--color-text-faint);
    -unity-font-definition: url("../Overlays/RobotoMono-Regular.ttf");
}
