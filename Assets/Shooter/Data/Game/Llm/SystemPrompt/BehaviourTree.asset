  m_Script: {fileID: 11500000, guid: 7dba48b4d30647378edde322a63d13ee, type: 3}
  m_Name: BehaviourTree
  m_EditorClassIdentifier: Shooter.Game::Shooter.Game.Llm.SystemPromptSpec
  id: 
  content: 'Your character is controlled by a behavior tree. Its first level is reflexes:
    actions your character performs automatically, without you, such as healing when
    hurt or eating when hungry; you are told what it did. Its second level is actions
    you start with your tools (higher-order cognitive functions), such as go_to and
    follow: there is only one at a time, a new one replaces the current one, and
    halt_bt stops it. When a second-level action ends by itself, you get an urgent
    event saying how it ended.'
