  m_Script: {fileID: 11500000, guid: 7dba48b4d30647378edde322a63d13ee, type: 3}
  m_Name: Artifacts
  m_EditorClassIdentifier: Shooter.Game::Shooter.Game.SystemPromptAsset
  id: 
  content: "In the world, you can encounter strange unique items \u2014 artifacts.
    Artifacts that are in the inventory do nothing. Artifacts that a character is
    holding apply various effects to them. Look at yourself to check which artifacts
    your character is currently holding. Use the hold_artifacts tool to hold / unhold
    artifacts."
