.debug-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: flex-end;
    padding: 4px 6px;
}

.debug {
    white-space: nowrap;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.9);
    -unity-font-definition: url("/Assets/Shooter/Data/Game/Interface/Overlays/RobotoMono-Regular.ttf");
    -unity-text-outline-width: 0.7px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
}
