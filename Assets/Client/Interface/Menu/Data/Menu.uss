.menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url("../../Overlays/Data/RobotoMono-Regular.ttf");
}

.menu__panel {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 660px;
    padding: 80px 44px 64px 44px;
    background-color: var(--color-panel);
    border-right-width: 1px;
    border-right-color: var(--color-line);
}

.menu__version {
    position: absolute;
    right: 28px;
    bottom: 20px;
    font-size: var(--text-small);
    color: var(--color-text-faint);
}

.screen {
    flex-grow: 1;
}

.screen__title {
    margin-bottom: var(--space-6);
    font-size: var(--text-title);
    color: var(--color-text);
}

.screen__body {
    flex-grow: 1;
}

.screen__section {
    margin: var(--space-8) 0 var(--space-1) 0;
    font-size: var(--text-base);
    color: var(--color-text);
}

.screen__hint {
    margin-bottom: var(--space-2);
    font-size: var(--text-small);
    color: var(--color-text-dim);
    white-space: normal;
}

.screen__caption {
    margin: var(--space-4) 0 var(--space-2) 0;
    font-size: var(--text-small);
    color: var(--color-text-faint);
}

.screen__footer {
    flex-direction: row;
    margin-top: var(--space-6);
}

.menu__item {
    margin-bottom: 2px;
    padding: 10px 16px;
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    font-size: var(--text-large);
    color: var(--color-text-dim);
}

.menu__item:hover {
    border-left-color: var(--color-accent);
    background-color: var(--color-hover);
    color: var(--color-text);
}

.menu__item:active {
    background-color: var(--color-accent-soft);
}

.menu__item--primary {
    color: var(--color-text);
}

.menu__note {
    margin: -4px 0 12px 18px;
    font-size: var(--text-small);
    color: var(--color-text-faint);
}

.menu__spacer {
    height: var(--space-6);
}

.field {
    margin-bottom: var(--space-2);
}

.action {
    margin-right: var(--space-2);
    padding: 8px 16px;
    border-width: 1px;
    border-color: var(--color-line-strong);
    color: var(--color-text);
}

.action:hover {
    border-color: var(--color-text);
}

.action--danger:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
}

.saves__list {
    flex-grow: 1;
}

.saves__empty {
    color: var(--color-text-faint);
}

.save {
    position: relative;
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-line);
}

.save:hover {
    background-color: var(--color-hover);
}

.save__preview {
    width: 128px;
    height: 72px;
    flex-shrink: 0;
    margin-right: 14px;
    background-color: rgba(255, 255, 255, 0.04);
    -unity-background-scale-mode: scale-and-crop;
}

.save__info {
    flex-grow: 1;
}

.save__stamp {
    font-size: var(--text-base);
    color: var(--color-text);
}

.save__version {
    margin-right: var(--space-3);
    font-size: var(--text-small);
    color: var(--color-text-faint);
}

.save__version--foreign {
    color: var(--color-accent);
}

.save__actions {
    flex-direction: row;
    align-items: center;
}

.save__action {
    margin-left: 6px;
    padding: 6px 10px;
    border-width: 1px;
    border-color: var(--color-line);
    font-size: var(--text-small);
    color: var(--color-text-dim);
}

.save__action:hover {
    border-color: var(--color-text);
    color: var(--color-text);
}

.dialog {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.55);
    display: none;
}

.dialog__window {
    width: 480px;
    padding: 24px 28px 20px 28px;
    border-width: 1px;
    border-color: var(--color-line-strong);
    background-color: var(--color-panel-solid);
}

.dialog__title {
    margin-bottom: var(--space-2);
    font-size: var(--text-large);
    color: var(--color-text);
}

.dialog__title--danger {
    color: var(--color-accent);
}

.dialog__text {
    margin-bottom: var(--space-6);
    font-size: var(--text-base);
    color: var(--color-text-dim);
    white-space: normal;
}

.dialog__actions {
    flex-direction: row;
    justify-content: flex-end;
}

.dialog__actions > .action {
    margin-right: 0;
    margin-left: var(--space-2);
}
