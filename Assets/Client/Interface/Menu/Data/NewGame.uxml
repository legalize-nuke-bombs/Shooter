<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Label text="Новая игра" class="screen__title"/>
    <ui:VisualElement class="screen__body">
        <ui:TextField label="Имя игрока" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Client.Name" binding-mode="TwoWay"/>
            </Bindings>
        </ui:TextField>
        <ui:TextField label="Порт" is-delayed="true" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Server.Port" binding-mode="TwoWay"/>
            </Bindings>
        </ui:TextField>
        <ui:Label text="Языковая модель" class="screen__section"/>
        <ui:Label text="Жители думают и говорят через неё. Без ключа они молчат." class="screen__hint"/>
        <ui:Label text="Простые операции" class="screen__caption"/>
        <ui:TextField label="Провайдер" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Server.LlmBase.Provider" binding-mode="TwoWay"/>
            </Bindings>
        </ui:TextField>
        <ui:TextField label="Модель" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Server.LlmBase.Model" binding-mode="TwoWay"/>
            </Bindings>
        </ui:TextField>
        <ui:TextField label="Ключ" password="true" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Server.LlmBase.Key" binding-mode="TwoWay"/>
            </Bindings>
        </ui:TextField>
        <ui:Label text="Сложные операции" class="screen__caption"/>
        <ui:TextField label="Провайдер" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Server.LlmMax.Provider" binding-mode="TwoWay"/>
            </Bindings>
        </ui:TextField>
        <ui:TextField label="Модель" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Server.LlmMax.Model" binding-mode="TwoWay"/>
            </Bindings>
        </ui:TextField>
        <ui:TextField label="Ключ" password="true" class="field">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Server.LlmMax.Key" binding-mode="TwoWay"/>
            </Bindings>
        </ui:TextField>
    </ui:VisualElement>
    <ui:VisualElement class="screen__footer">
        <ui:Button name="back" text="Назад" class="action"/>
        <ui:Button name="start" text="Начать" class="action"/>
    </ui:VisualElement>
</ui:UXML>
