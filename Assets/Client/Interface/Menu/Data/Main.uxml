<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="screen__body">
        <ui:Button name="continue" text="Продолжить" class="menu__item menu__item--primary"/>
        <ui:Label name="continue-note" class="menu__note"/>
        <ui:Button name="worlds" text="Миры" class="menu__item"/>
        <ui:Button name="new" text="Новый мир" class="menu__item"/>
        <ui:Button name="join" text="Присоединиться" class="menu__item"/>
        <ui:VisualElement class="menu__spacer"/>
        <ui:Button name="settings" text="Настройки" class="menu__item"/>
        <ui:Button name="quit" text="Выйти" class="menu__item"/>
    </ui:VisualElement>
</ui:UXML>
