<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Menu.uss"/>
    <ui:VisualElement name="menu" class="menu" picking-mode="Ignore">
        <ui:VisualElement name="panel" class="menu__panel"/>
        <ui:Label name="version" class="menu__version" picking-mode="Ignore"/>
        <ui:VisualElement name="dialog" class="dialog">
            <ui:VisualElement class="dialog__window">
                <ui:Label name="dialog-title" class="dialog__title"/>
                <ui:Label name="dialog-text" class="dialog__text"/>
                <ui:VisualElement class="dialog__actions">
                    <ui:Button name="dialog-cancel" text="Отмена" class="action"/>
                    <ui:Button name="dialog-confirm" class="action action--danger"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
