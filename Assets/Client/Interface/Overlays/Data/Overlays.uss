.overlays {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 4px 6px;
}

.corner {
    flex-direction: column;
}

.corner--right {
    align-items: flex-end;
}

.corner__line {
    font-size: 10px;
    -unity-font-definition: url("RobotoMono-Regular.ttf");
}

.line {
    color: rgb(255, 255, 255);
    font-size: 13px;
}

.target {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin-top: 24px;
    font-size: 15px;
    -unity-text-align: middle-center;
}

.hint {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin-top: 48px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.8);
    -unity-text-align: middle-center;
}

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
}

.crosshair__bar {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.85);
}

.crosshair__bar--up {
    width: 2px;
    height: 5px;
    margin-left: -1px;
    margin-top: -8px;
}

.crosshair__bar--down {
    width: 2px;
    height: 5px;
    margin-left: -1px;
    margin-top: 3px;
}

.crosshair__bar--left {
    width: 5px;
    height: 2px;
    margin-left: -8px;
    margin-top: -1px;
}

.crosshair__bar--right {
    width: 5px;
    height: 2px;
    margin-left: 3px;
    margin-top: -1px;
}

.bar {
    position: absolute;
    left: 10px;
    bottom: 10px;
    width: 18%;
    min-width: 140px;
    max-width: 260px;
    height: 10px;
    background-color: rgba(0, 0, 0, 0.55);
}

.bar__fill {
    height: 100%;
    width: 100%;
    background-color: rgb(168, 51, 51);
}

.bar--stamina {
    bottom: 24px;
    height: 6px;
}

.bar__fill--stamina {
    background-color: rgb(74, 138, 176);
}

.hunger {
    position: absolute;
    left: 10px;
    bottom: 40px;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 22px;
    background-color: rgba(0, 0, 0, 0.55);
}

.hunger__glyph {
    position: absolute;
    width: 30px;
    height: 30px;
    opacity: 0.22;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.hunger__amount {
    color: rgba(255, 255, 255, 0.92);
    font-size: 18px;
}

.ammo {
    position: absolute;
    right: 14px;
    bottom: 10px;
    flex-direction: row;
    align-items: flex-end;
}

.ammo__magazine {
    color: rgba(255, 255, 255, 0.92);
    font-size: 32px;
    -unity-font-style: bold;
}

.ammo__reserve {
    color: rgba(255, 255, 255, 0.5);
    font-size: 16px;
    margin-left: 6px;
    margin-bottom: 6px;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    display: none;
}

.inventory {
    padding: 18px 20px;
    background-color: rgba(8, 8, 10, 0.94);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
}

.inventory__caption {
    color: rgba(255, 255, 255, 0.45);
    font-size: 12px;
    margin-bottom: 6px;
}

.inventory__grid {
    position: relative;
}

.inventory__grid--hands {
    margin-bottom: 14px;
}

.ghost {
    position: absolute;
    opacity: 0.8;
}

.grid__cell {
    position: absolute;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    background-color: rgba(255, 255, 255, 0.025);
}

.inventory__money {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 8px;
}

.inventory__coins {
    font-size: 18px;
    margin-left: 10px;
}

.inventory__empty {
    color: rgba(255, 255, 255, 0.45);
}

.slot {
    margin: 0;
    padding: 3px;
    justify-content: center;
    align-items: center;
    border-width: 1px;
    border-radius: 0;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(255, 255, 255, 0.05);
}

.slot:hover {
    background-color: rgba(255, 255, 255, 0.11);
}

.slot--held {
    border-color: rgba(255, 255, 255, 0.22);
}

.slot--fixed:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.slot__icon {
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.slot__amount {
    position: absolute;
    right: 2px;
    bottom: 0;
    font-size: 12px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.slot__name {
    color: rgba(255, 255, 255, 0.75);
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.menu-curtain {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.context-menu {
    position: absolute;
    min-width: 140px;
    padding: 3px;
    background-color: rgb(24, 24, 24);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.22);
}

.context-menu__item {
    margin: 0;
    padding: 6px 10px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: rgba(255, 255, 255, 0.85);
    font-size: 13px;
    -unity-text-align: middle-left;
}

.context-menu__item:hover {
    background-color: rgba(255, 255, 255, 0.12);
    color: rgb(255, 255, 255);
}

.talk {
    position: absolute;
    left: 50%;
    bottom: 6%;
    translate: -50% 0;
    width: 46%;
    min-width: 320px;
    max-width: 620px;
    padding: 12px;
    background-color: rgba(8, 8, 10, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    display: none;
}

.talk__name {
    font-size: 14px;
    margin-bottom: 8px;
}

.talk__log {
    flex-direction: column;
    max-height: 220px;
}

.talk__waiting {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    -unity-font-style: italic;
    margin-top: 4px;
    display: none;
}

.talk__line {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.85);
    white-space: normal;
    margin-bottom: 4px;
}

.talk__line--mine {
    color: rgba(255, 255, 255, 0.55);
}

.talk__input {
    margin: 8px 0 6px 0;
}

.talk__input .unity-text-field__input {
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 0;
    padding: 5px 7px;
    font-size: 13px;
    color: rgb(255, 255, 255);
    --unity-cursor-color: rgb(255, 255, 255);
    --unity-selection-color: rgba(168, 51, 51, 0.5);
}

.talk__help {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.4);
}

.sleep {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.loading {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    justify-content: center;
    align-items: center;
}

.loading__status {
    font-size: 30px;
    color: var(--color-text);
    -unity-font-definition: url("RobotoMono-Regular.ttf");
}

.loading__tip {
    position: absolute;
    right: var(--space-6);
    bottom: var(--space-6);
    max-width: 360px;
    white-space: normal;
    -unity-text-align: middle-right;
    font-size: var(--text-small);
    color: var(--color-text-faint);
    -unity-font-definition: url("RobotoMono-Regular.ttf");
}

.debug {
    margin-top: 6px;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.9);
    -unity-text-outline-width: 0.7px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
}

.notifications {
    position: absolute;
    right: 6px;
    top: 4px;
    flex-direction: column;
    align-items: flex-end;
}

.notification {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    padding: 0 10px 0 0;
    min-width: 176px;
    background-color: rgba(8, 8, 8, 0.78);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.notification__icon {
    width: 48px;
    height: 48px;
    margin-right: 9px;
    background-color: rgba(214, 198, 160, 0.06);
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.notification__body {
    flex-direction: column;
    padding: 6px 0;
}

.notification__title {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.92);
}

.notification__from {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.45);
    -unity-font-definition: url("RobotoMono-Regular.ttf");
}

.pause {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.55);
    display: none;
}

.pause__panel {
    width: 440px;
    padding: 32px 28px;
    background-color: var(--color-panel-solid);
    border-width: 1px;
    border-color: var(--color-line-strong);
}

.pause__item {
    margin-bottom: 6px;
    padding: 16px 22px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    font-size: 21px;
    color: var(--color-text-dim);
    -unity-text-align: middle-left;
}

.pause__item:hover {
    border-left-color: var(--color-accent);
    background-color: var(--color-hover);
    color: var(--color-text);
}

.pause__item:active {
    background-color: var(--color-accent-soft);
}