.overlays {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 4px 6px;
}

.corner {
    flex-direction: column;
}

.corner--right {
    align-items: flex-end;
}

.corner__line {
    font-size: 10px;
    -unity-font-definition: url("RobotoMono-Regular.ttf");
}

.line {
    color: rgb(255, 255, 255);
    font-size: 13px;
}

.target {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin-top: 24px;
    font-size: 15px;
    -unity-text-align: middle-center;
}

.hint {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin-top: 48px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.8);
    -unity-text-align: middle-center;
}

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    margin-top: -2px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.75);
}

.bar {
    position: absolute;
    left: 10px;
    bottom: 10px;
    width: 18%;
    min-width: 140px;
    max-width: 260px;
    height: 10px;
    background-color: rgba(0, 0, 0, 0.55);
}

.bar__fill {
    height: 100%;
    width: 100%;
    background-color: rgb(168, 51, 51);
}

.inventory {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 28%;
    min-width: 260px;
    max-width: 380px;
    padding: 12px;
    background-color: rgba(8, 8, 10, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    display: none;
}

.inventory__title {
    font-size: 14px;
    margin-bottom: 8px;
}

.inventory__slots {
    flex-direction: column;
}

.inventory__empty {
    color: rgba(255, 255, 255, 0.45);
}

.slot {
    flex-direction: row;
    justify-content: space-between;
    margin: 0 0 2px 0;
    padding: 5px 7px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(255, 255, 255, 0.05);
}

.slot:hover {
    background-color: rgba(255, 255, 255, 0.11);
}

.slot--held {
    background-color: rgba(168, 51, 51, 0.4);
}

.slot--held:hover {
    background-color: rgba(168, 51, 51, 0.6);
}

.slot--fixed:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.slot--fixed {
    opacity: 0.5;
}

.slot__name {
    color: rgb(255, 255, 255);
    font-size: 13px;
}

.slot__amount {
    color: rgba(255, 255, 255, 0.6);
    font-size: 13px;
}

.talk {
    position: absolute;
    left: 50%;
    bottom: 6%;
    translate: -50% 0;
    width: 46%;
    min-width: 320px;
    max-width: 620px;
    padding: 12px;
    background-color: rgba(8, 8, 10, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    display: none;
}

.talk__name {
    font-size: 14px;
    margin-bottom: 8px;
}

.talk__log {
    flex-direction: column;
    max-height: 220px;
}

.talk__waiting {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    -unity-font-style: italic;
    margin-top: 4px;
    display: none;
}

.talk__line {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.85);
    white-space: normal;
    margin-bottom: 4px;
}

.talk__line--mine {
    color: rgba(255, 255, 255, 0.55);
}

.talk__input {
    margin: 8px 0 6px 0;
}

.talk__input .unity-text-field__input {
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 0;
    padding: 5px 7px;
    font-size: 13px;
    color: rgb(255, 255, 255);
    --unity-cursor-color: rgb(255, 255, 255);
    --unity-selection-color: rgba(168, 51, 51, 0.5);
}

.talk__help {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.4);
}

.dream {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}
