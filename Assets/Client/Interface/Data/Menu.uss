.menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    justify-content: center;
    align-items: center;
}

.screen {
    width: 34%;
    min-width: 300px;
    max-width: 420px;
    flex-direction: column;
}

.menu__button {
    margin: 0 0 6px 0;
    padding: 9px 12px;
    border-width: 1px;
    border-radius: 0;
    border-color: rgba(255, 255, 255, 0.14);
    background-color: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.85);
    font-size: 14px;
    -unity-text-align: middle-left;
    -unity-font-definition: url("../Overlays/Data/RobotoMono-Regular.ttf");
}

.menu__button:hover {
    background-color: rgba(255, 255, 255, 0.11);
    color: rgb(255, 255, 255);
}

.menu__button:active {
    background-color: rgba(168, 51, 51, 0.4);
}

.menu__tabs {
    flex-direction: row;
    margin: 0 0 10px 0;
}

.menu__tab {
    flex-grow: 1;
    margin: 0 6px 0 0;
    padding: 7px 12px;
    border-width: 1px;
    border-radius: 0;
    border-color: rgba(255, 255, 255, 0.14);
    background-color: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.5);
    font-size: 14px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("../Overlays/Data/RobotoMono-Regular.ttf");
}

.menu__tab:hover {
    color: rgb(255, 255, 255);
}

.menu__tab--chosen {
    background-color: rgba(255, 255, 255, 0.11);
    border-color: rgba(168, 51, 51, 0.7);
    color: rgb(255, 255, 255);
}

.menu__title {
    margin: 10px 0 6px 0;
    color: rgba(255, 255, 255, 0.45);
    font-size: 12px;
    -unity-font-definition: url("../Overlays/Data/RobotoMono-Regular.ttf");
}

.menu__field {
    margin: 0 0 6px 0;
}

.menu__field > Label {
    min-width: 140px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 13px;
}

.menu__field .unity-text-field__input {
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 0;
    padding: 5px 7px;
    font-size: 13px;
    color: rgb(255, 255, 255);
    --unity-cursor-color: rgb(255, 255, 255);
    --unity-selection-color: rgba(168, 51, 51, 0.5);
}
