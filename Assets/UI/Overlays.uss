.overlays {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 10px;
}

.corner {
    flex-direction: column;
}

.corner--right {
    align-items: flex-end;
}

.line {
    color: rgb(255, 255, 255);
    font-size: 14px;
}

.target {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin-top: 24px;
    font-size: 15px;
    -unity-text-align: middle-center;
}

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    margin-top: -2px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.75);
}

.bar {
    position: absolute;
    left: 10px;
    bottom: 10px;
    width: 220px;
    height: 10px;
    background-color: rgba(0, 0, 0, 0.55);
}

.bar__fill {
    height: 100%;
    width: 100%;
    background-color: rgb(168, 51, 51);
}
