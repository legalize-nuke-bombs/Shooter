.overlays {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 10px;
}

.corner {
    flex-direction: column;
}

.corner--right {
    align-items: flex-end;
}

.line {
    color: rgb(255, 255, 255);
    font-size: 14px;
}

.target {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin-top: 24px;
    font-size: 15px;
    -unity-text-align: middle-center;
}

.hint {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin-top: 48px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.8);
    -unity-text-align: middle-center;
}

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    margin-top: -2px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.75);
}

.bar {
    position: absolute;
    left: 10px;
    bottom: 10px;
    width: 220px;
    height: 10px;
    background-color: rgba(0, 0, 0, 0.55);
}

.bar__fill {
    height: 100%;
    width: 100%;
    background-color: rgb(168, 51, 51);
}

.inventory {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 340px;
    margin-left: -170px;
    margin-top: -170px;
    padding: 12px;
    background-color: rgba(8, 8, 10, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    display: none;
}

.inventory__title {
    font-size: 15px;
    margin-bottom: 8px;
}

.inventory__slots {
    flex-direction: column;
}

.inventory__empty {
    color: rgba(255, 255, 255, 0.45);
}

.slot {
    flex-direction: row;
    justify-content: space-between;
    margin: 0 0 2px 0;
    padding: 5px 7px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(255, 255, 255, 0.05);
}

.slot:hover {
    background-color: rgba(255, 255, 255, 0.11);
}

.slot--held {
    background-color: rgba(168, 51, 51, 0.4);
}

.slot--fixed {
    opacity: 0.5;
}

.slot__name {
    color: rgb(255, 255, 255);
    font-size: 14px;
}

.slot__amount {
    color: rgba(255, 255, 255, 0.6);
    font-size: 14px;
}

.dream {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}
