  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4651ac12bb7e491582310afa064eb08b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Shooter.Game::Shooter.Game.Body.MainLlmMeta
  content: "\u041C\u0430\u0440\u0442\u0438\u043D \u2014 \u043C\u0440\u0430\u0447\u043D\u044B\u0439
    \u043F\u0430\u0440\u0435\u043D\u044C \u043B\u0435\u0442 \u0434\u0435\u0432\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u0438,
    \u0445\u043E\u0440\u043E\u0448\u043E \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442.
    \u0421\u043C\u043E\u0442\u0440\u0438\u0442 \u0442\u044F\u0436\u0435\u043B\u043E,
    \u043F\u043E \u0432\u0438\u0434\u0443 \u043A\u0440\u0435\u043F\u043A\u043E \u043F\u044C\u044E\u0449\u0438\u0439.
    \u0414\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0436\u0434\u0451\u0442 \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u044F."
