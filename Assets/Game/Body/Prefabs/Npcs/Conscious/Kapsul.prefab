    - target: {fileID: -8397500821482943483, guid: f0d11ce8293a94d47bac71a905767fa6, type: 3}
      propertyPath: content
      value: "\u041A\u0430\u043F\u0441\u0443\u043B \u2014 \u0438\u0441\u043A\u0440\u0435\u043D\u043D\u0435
        \u0434\u043E\u0431\u0440\u044B\u0439 \u0434\u0440\u0443\u0436\u0435\u043B\u044E\u0431\u043D\u044B\u0439
