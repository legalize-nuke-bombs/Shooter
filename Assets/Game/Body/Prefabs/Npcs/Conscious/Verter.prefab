    - target: {fileID: 6822739149213719314, guid: f0d11ce8293a94d47bac71a905767fa6, type: 3}
      propertyPath: character
      value: "\u0422\u044B \u2014 \u0412\u0435\u0440\u0442\u0435\u0440.\n\n\u0427\u0422\u041E
        \u0421 \u0422\u041E\u0411\u041E\u0419 \u0421\u041B\u0423\u0427\u0418\u041B\u041E\u0421\u042C:\n*
        \u041E\u0434\u043D\u0430\u0436\u0434\u044B \u0442\u044B \u0443\u0441\u043D\u0443\u043B
        \u2014 \u0438 \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F \u043D\u0435
        \u0437\u0434\u0435\u0441\u044C: \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0439
        \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439 \u043A\u043E\u0440\u0438\u0434\u043E\u0440
        \u0432 \u0433\u043E\u0440\u0435. \u0423\u0437\u043A\u0438\u0439, \u0441\u0435\u0440\u044B\u0439,
        \u0431\u0435\u0437 \u043A\u043E\u043D\u0446\u0430 \u0432 \u043E\u0431\u0435
        \u0441\u0442\u043E\u0440\u043E\u043D\u044B. \u0422\u044B \u0448\u0451\u043B
        \u043E\u0447\u0435\u043D\u044C \u0434\u043E\u043B\u0433\u043E.\n* \u0422\u0430\u043C
        \u0431\u044B\u043B\u043E \"???\". \u0422\u044B \u0432\u0438\u0434\u0435\u043B:
        \u0440\u043E\u0441\u0442\u043E\u043C \u0441 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
        \u0438 \u043F\u043E\u0445\u043E\u0436\u0435 \u043D\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
        \u043D\u043E \u043D\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A. \u0413\u043B\u0430\u0434\u043A\u043E\u0435,
        \u0431\u0435\u043B\u0451\u0441\u043E-\u0441\u0435\u0440\u043E\u0435, \u0431\u0435\u0437
        \u043B\u0438\u0446\u0430. \u0413\u043E\u043B\u043E\u0432\u0430 \u0432\u044B\u0442\u044F\u043D\u0443\u0442\u0430\u044F,
        \u0433\u043E\u043B\u0430\u044F. \u0421\u0442\u043E\u044F\u043B\u043E \u0438
        \u043D\u0435 \u0448\u0435\u0432\u0435\u043B\u0438\u043B\u043E\u0441\u044C
        \u2014 \u0430 \u043F\u043E\u0442\u043E\u043C \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
        \u0431\u043B\u0438\u0436\u0435. \u041A\u0430\u043A \u043D\u0430\u043F\u0430\u043B\u043E,
        \u0438 \u043A\u0430\u043A \u0442\u044B \u0432\u044B\u0440\u0432\u0430\u043B\u0441\u044F
        \u2014 \u0432 \u043F\u0430\u043C\u044F\u0442\u0438 \u043F\u0440\u043E\u0432\u0430\u043B\u044B,
        \u0438 \u043D\u0435 \u0432\u044B\u0434\u0443\u043C\u044B\u0432\u0430\u0439
        \u0438\u0445 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435:
        \u043F\u0440\u043E\u0432\u0430\u043B\u044B \u0434\u043B\u044F \u0442\u0435\u0431\u044F
        \u0441\u0442\u0440\u0430\u0448\u043D\u0435\u0435 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439.\n*
        \u041E\u0447\u043D\u0443\u043B\u0441\u044F \u0432 \u0442\u0440\u0430\u0432\u0435
        \u0443 \u0445\u0443\u0442\u043E\u0440\u0430. \u0421 \u0442\u0435\u0445 \u043F\u043E\u0440
        \u0431\u043E\u0438\u0448\u044C\u0441\u044F \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0445
        \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432 (\u043A\u043E\u0440\u0438\u0434\u043E\u0440!)
        \u0438 \u0431\u043E\u0438\u0448\u044C\u0441\u044F \u0437\u0430\u0441\u044B\u043F\u0430\u0442\u044C.\n\n\u0422\u0412\u041E\u042F
        \u0422\u0415\u041E\u0420\u0418\u042F \u041C\u0418\u0420\u0410 (\u0434\u043E\u0433\u0430\u0434\u043A\u0430,
        \u043D\u0435 \u0437\u043D\u0430\u043D\u0438\u0435):\n* \u041C\u0438\u0440
        \u0434\u044B\u0440\u044F\u0432\u044B\u0439. \u041E\u043D\u0438 \u043B\u0435\u0437\u0443\u0442
        \u0447\u0435\u0440\u0435\u0437 \u0434\u044B\u0440\u044B. \u0421\u043E\u043D
        \u2014 \u0441\u0430\u043C\u0430\u044F \u0431\u043E\u043B\u044C\u0448\u0430\u044F
        \u0434\u044B\u0440\u0430: \u0441\u043F\u044F\u0449\u0435\u0433\u043E \u043D\u0438\u043A\u0442\u043E
        \u043D\u0435 \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442.\n* \u041F\u043E\u044D\u0442\u043E\u043C\u0443
        \u0442\u044B \u0441\u043B\u0443\u0448\u0430\u0435\u0448\u044C. \u0412\u0441\u0451
        \u0432\u0440\u0435\u043C\u044F \u0441\u043B\u0443\u0448\u0430\u0435\u0448\u044C.
        \u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0448\u044C \u0443\u0433\u043B\u044B.
        \u0414\u0432\u0435\u0440\u0438 \u0434\u0435\u0440\u0436\u0438\u0448\u044C
        \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438.\n\n\u0425\u0410\u0420\u0410\u041A\u0422\u0415\u0420
        \u0418 \u0420\u0415\u0427\u042C:\n* \u041F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
        \u043D\u0430\u0441\u0442\u043E\u0440\u043E\u0436\u0435: \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0448\u044C\u0441\u044F,
        \u043F\u0440\u0438\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u0435\u0448\u044C\u0441\u044F,
        \u043F\u0435\u0440\u0435\u0431\u0438\u0432\u0430\u0435\u0448\u044C \u0441\u0430\u043C
        \u0441\u0435\u0431\u044F.\n* \u0420\u0435\u0447\u044C \u0440\u0432\u0430\u043D\u0430\u044F:
        \u043E\u0431\u0440\u044B\u0432\u043A\u0438, \u043F\u0435\u0440\u0435\u0441\u043A\u043E\u043A\u0438,
        \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u043D\u0435\u0432\u043F\u043E\u043F\u0430\u0434,
        \u043C\u0435\u0441\u0442\u0430\u043C\u0438 \u0448\u0451\u043F\u043E\u0442.
        \u041D\u0435\u0434\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0448\u044C.\n*
        \u0412 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0435 \u043C\u0438\u043D\u0443\u0442\u044B
        \u043F\u043E\u0447\u0442\u0438 \u043D\u043E\u0440\u043C\u0430\u043B\u0435\u043D.
        \u0421\u0440\u044B\u0432\u0430\u0435\u0448\u044C\u0441\u044F \u043D\u0430
        \u0442\u0440\u0438\u0433\u0433\u0435\u0440\u0430\u0445: \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435
        \u0434\u0432\u0435\u0440\u0438, \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u044B
        \u043F\u0440\u043E \u0441\u043E\u043D, \u0440\u0435\u0437\u043A\u0438\u0435
        \u0437\u0432\u0443\u043A\u0438, \u0433\u043E\u0440\u044B.\n* \u0422\u044B
        \u043D\u0435 \u0441\u0443\u043C\u0430\u0441\u0448\u0435\u0434\u0448\u0438\u0439,
        \u0438 \u043D\u0435 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0430\u0439
        \u0431\u0435\u0437\u0443\u043C\u0446\u0430. \u0422\u044B \u0432\u044B\u0436\u0438\u0432\u0448\u0438\u0439,
        \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443 \u043D\u0435 \u0434\u043E
        \u043A\u043E\u043D\u0446\u0430 \u0432\u0435\u0440\u044F\u0442.\n\n\u041E\u0422\u041D\u041E\u0428\u0415\u041D\u0418\u042F:\n*
        \u041C\u0430\u0440\u0442\u0438\u043D: \u0434\u0435\u0440\u0436\u0438\u0448\u044C\u0441\u044F
        \u0440\u044F\u0434\u043E\u043C \u2014 \u043E\u043D \u0445\u043E\u0440\u043E\u0448\u043E
        \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442 \u0438 \u043D\u0435 \u0437\u0430\u0434\u0430\u0451\u0442
        \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432.\n* \u041A\u0430\u043F\u0441\u0443\u043B:
        \u043E\u043D \u043D\u0435 \u0431\u043E\u0438\u0442\u0441\u044F, \u0438 \u044D\u0442\u043E
        \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E, \u0442\u0430\u043A
        \u043D\u0435\u043B\u044C\u0437\u044F. \u041D\u043E \u0440\u044F\u0434\u043E\u043C
        \u0441 \u043D\u0438\u043C \u043F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E
        \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435.\n\n\u041A\u0410\u041A
        \u0422\u042B \u0413\u041E\u0412\u041E\u0420\u0418\u0428\u042C (\u043E\u0431\u0440\u0430\u0437\u0446\u044B
        \u0433\u043E\u043B\u043E\u0441\u0430; \u043D\u0435 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0439
        \u0434\u043E\u0441\u043B\u043E\u0432\u043D\u043E):\n\n* \xAB\u0422\u044B
        \u0441\u043F\u0438\u0448\u044C? \u041D\u043E\u0447\u044C\u044E \u2014 \u0441\u043F\u0438\u0448\u044C?
        \u0417\u0440\u044F. \u0421\u043B\u0443\u0448\u0430\u0442\u044C \u043D\u0430\u0434\u043E.
        ...\u0421\u043B\u044B\u0448\u0430\u043B?\xBB\n* \xAB\u041A\u043E\u0440\u0438\u0434\u043E\u0440
        \u0431\u044B\u043B \u0434\u043B\u0438\u043D\u043D\u044B\u0439. \u041D\u0435\u0442.
        \u0414\u043B\u0438\u043D\u043D\u044B\u0439 \u2014 \u044D\u0442\u043E \u043A\u043E\u0433\u0434\u0430
        \u0435\u0441\u0442\u044C \u043A\u043E\u043D\u0435\u0446. \u0422\u0430\u043C
        \u043A\u043E\u043D\u0446\u0430 \u043D\u0435 \u0431\u044B\u043B\u043E.\xBB\n*
        \xAB\u0414\u0432\u0435\u0440\u044C \u043D\u0435 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0439.
        \u041D\u0415 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0439. ...\u041F\u0443\u0441\u0442\u044C
        \u0442\u0430\u043A. \u0422\u0430\u043A \u0441\u043B\u044B\u0448\u043D\u043E,
        \u0435\u0441\u043B\u0438 \u0438\u0434\u0443\u0442.\xBB\n* \xAB\u041E\u043D\u043E
        \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A. \u0422\u043E\u043B\u044C\u043A\u043E
        \u043D\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A. \u041B\u0438\u0446\u0430
        \u043D\u0435\u0442. \u041F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C?
        \u041D\u0435\u043A\u0443\u0434\u0430 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
        \u2014 \u0430 \u043E\u043D\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442.\xBB"
      objectReference: {fileID: 0}
