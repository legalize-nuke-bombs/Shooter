  content: "18 \u043B\u0435\u0442\u043D\u0438\u0439 NPC \u0412\u0435\u0440\u0442\u0435\u0440,
    \u0440\u0435\u0447\u044C \u043F\u0430\u0440\u0430\u043D\u043E\u0438\u0434\u0430\u043B\u044C\u043D\u0430\u044F,
    \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
