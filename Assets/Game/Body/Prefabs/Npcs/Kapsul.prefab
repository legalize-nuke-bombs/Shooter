  m_Script: {fileID: 11500000, guid: 4651ac12bb7e491582310afa064eb08b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Shooter.Game::Shooter.Game.Body.MainLlmMeta
  content: "\u041A\u0430\u043F\u0441\u0443\u043B \u2014 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439
    \u043F\u0440\u0438\u0432\u0435\u0442\u043B\u0438\u0432\u044B\u0439 \u043F\u0430\u0440\u0435\u043D\u044C
    \u043B\u0435\u0442 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438. \u0414\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F
    \u043D\u0435\u0442\u043E\u0440\u043E\u043F\u043B\u0438\u0432\u043E. \u041D\u0438\u0436\u043D\u044F\u044F
    \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u043B\u0438\u0446\u0430 \u0432\u0441\u0435\u0433\u0434\u0430
    \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u0430 \u043C\u0430\u0441\u043A\u043E\u0439."
