  m_EditorClassIdentifier: Shooter.Game::Shooter.Game.Body.MainLlmMeta
  content: "\u0414\u0440\u0443\u0436\u0435\u043B\u044E\u0431\u043D\u044B\u0439 20
    \u043B\u0435\u0442\u043D\u0438\u0439 NPC \u041A\u0430\u043F\u0441\u0443\u043B,
    \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u0432 \u0438\u0433\u0440\u0435
    \u0440\u0430\u043D\u044C\u0448\u0435 \u0432\u0441\u0435\u0445"
