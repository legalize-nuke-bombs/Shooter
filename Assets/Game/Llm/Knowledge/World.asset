  m_Script: {fileID: 11500000, guid: f7e14400444a4969810053fa17585059, type: 3}
  m_Name: World
  m_EditorClassIdentifier: Shooter.Game::Shooter.Game.Llm.Knowledge.KnowledgeSpec
  id: 
  content: "\u041C\u0438\u0440 \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437
    \u0433\u043B\u0443\u0445\u0438\u0445 \u043C\u0435\u0441\u0442, \u043B\u0435\u0441\u043E\u0432,
    \u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0445 \u043F\u043E\u0441\u0451\u043B\u043A\u043E\u0432
    \u0438 \u0445\u0443\u0442\u043E\u0440\u043E\u0432, \u0440\u0430\u0437\u0431\u0438\u0442\u044B\u0445
    \u0434\u043E\u0440\u043E\u0433. \u0412\u0441\u044E\u0434\u0443 \u043F\u043B\u043E\u0442\u043D\u044B\u0439
    \u0442\u0443\u043C\u0430\u043D, \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u044C
    \u043F\u043B\u043E\u0445\u0430\u044F. \u0421\u0440\u0435\u0434\u0438 \u0441\u0442\u0430\u0440\u044B\u0445
    \u0440\u0430\u0437\u0432\u0430\u043B\u0438\u043D \u043F\u043E\u043F\u0430\u0434\u0430\u044E\u0442\u0441\u044F
    \u0432\u0435\u0449\u0438 \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E\u0433\u043E
    \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F
    \u2014 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043D\u043E\u0432\u044B\u0435,
    \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435
    \u0434\u043B\u044F \u044D\u0442\u0438\u0445 \u043C\u0435\u0441\u0442. \u041A\u043E\u0435-\u0433\u0434\u0435
    \u0441\u0430\u043C\u043E \u043F\u043E \u0441\u0435\u0431\u0435 \u0435\u0441\u0442\u044C
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u043E:
    \u0433\u0434\u0435-\u0442\u043E \u0433\u043E\u0440\u0438\u0442 \u0441\u0432\u0435\u0442,
    \u0433\u0434\u0435-\u0442\u043E \u0448\u0438\u043F\u044F\u0442 \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440\u044B
    \u0431\u0435\u043B\u044B\u043C \u0448\u0443\u043C\u043E\u043C. \u041F\u043E\u0447\u0435\u043C\u0443
    \u2014 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0437\u043D\u0430\u0435\u0442.\n\u041F\u043E
    \u043E\u043A\u0440\u0443\u0433\u0435 \u0431\u0440\u043E\u0434\u044F\u0442 \u043C\u0443\u0442\u0430\u043D\u0442\u044B.
    \u041D\u043E\u0447\u044C\u044E \u0438\u0445 \u0431\u043E\u043B\u044C\u0448\u0435.
    \u0412 \u0442\u0443\u043C\u0430\u043D\u0435 \u0438\u043D\u043E\u0433\u0434\u0430
    \u043A\u0442\u043E-\u0442\u043E \u0445\u043E\u0434\u0438\u0442: \u0442\u043E\u043F\u043E\u0442,
    \u0437\u0432\u0443\u043A\u0438. \u041A\u0442\u043E \u2014 \u043D\u0435 \u0437\u043D\u0430\u0435\u0442
    \u043D\u0438\u043A\u0442\u043E. \u0421\u043B\u044B\u0448\u0430\u043B\u0438 \u0432\u0441\u0435,
    \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0442\u044C \u043D\u0435 \u043B\u044E\u0431\u044F\u0442.\n\u0418\u0437
    \u0442\u0443\u043C\u0430\u043D\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
    \u0447\u0443\u0436\u0430\u043A\u0438 \u2014 \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A\u0438.
    \u0420\u0430\u0437\u043D\u044B\u0435: \u0442\u043E\u0440\u0433\u0443\u044E\u0442,
    \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442, \u0432\u043E\u0440\u0443\u044E\u0442,
    \u0443\u0431\u0438\u0432\u0430\u044E\u0442. \u0427\u0430\u0441\u0442\u043E \u0432\u0440\u0443\u0442
    \u0438 \u0447\u0430\u0441\u0442\u043E \u043D\u0435\u0441\u0443\u0442 \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u044B\u0439
    \u0431\u0440\u0435\u0434 \u2014 \u043A \u044D\u0442\u043E\u043C\u0443 \u0432\u0441\u0435
    \u043F\u0440\u0438\u0432\u044B\u043A\u043B\u0438. \u0421\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A\u0430\u043C\u0438
    \u0442\u0432\u043E\u0440\u0438\u0442\u0441\u044F \u0436\u0443\u0442\u044C, \u043A
    \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043C\u0435\u0441\u0442\u043D\u044B\u0435
    \u0442\u043E\u0436\u0435 \u043F\u0440\u0438\u0432\u044B\u043A\u043B\u0438: \u0443
    \u043C\u0451\u0440\u0442\u0432\u043E\u0433\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A\u0430
    \u043F\u0440\u043E\u043F\u0430\u0434\u0430\u0435\u0442 \u0438\u043C\u044F. \u041F\u043E\u0433\u0438\u0431
    \u2014 \u0438 \u043B\u0435\u0436\u0438\u0442 \u0431\u0435\u0437\u044B\u043C\u044F\u043D\u043D\u044B\u0439,
    \u043D\u0435 \u043E\u0442\u043B\u0438\u0447\u0438\u0448\u044C \u043E\u0442 \u0434\u0440\u0443\u0433\u0438\u0445
    \u043C\u0451\u0440\u0442\u0432\u044B\u0445. \u0410 \u043F\u043E\u0442\u043E\u043C
    \u0438\u0437 \u0442\u0443\u043C\u0430\u043D\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442
    \u043A\u0442\u043E-\u0442\u043E \u043E\u0447\u0435\u043D\u044C \u043F\u043E\u0445\u043E\u0436\u0438\u0439,
    \u0436\u0438\u0432\u043E\u0439, \u0441\u043D\u043E\u0432\u0430 \u0441 \u0438\u043C\u0435\u043D\u0435\u043C.
    \u0427\u0442\u043E \u044D\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442 \u2014
    \u043D\u0435 \u0437\u043D\u0430\u0435\u0442 \u043D\u0438\u043A\u0442\u043E. \u0421\u0443\u0435\u0432\u0435\u0440\u0438\u044F:
    \u043C\u0451\u0440\u0442\u0432\u044B\u0445 \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432
    \u043F\u043E \u0438\u043C\u0435\u043D\u0438 \u043D\u0435 \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442;
    \u0434\u043E\u043B\u0433\u043E \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \u043D\u0430 \u0431\u0435\u0437\u044B\u043C\u044F\u043D\u043D\u043E\u0433\u043E
    \u043C\u0435\u0440\u0442\u0432\u0435\u0446\u0430 \u2014 \u043F\u043B\u043E\u0445\u0430\u044F
    \u043F\u0440\u0438\u043C\u0435\u0442\u0430. \u0416\u0438\u0442\u0435\u043B\u0438
    \u2014 \u043D\u0435 \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A\u0438. \u0415\u0441\u043B\u0438
    \u0436\u0438\u0442\u0435\u043B\u044C \u0443\u043C\u0440\u0451\u0442, \u043F\u043E\u0445\u043E\u0436\u0438\u0439
    \u0438\u0437 \u0442\u0443\u043C\u0430\u043D\u0430 \u043D\u0435 \u043F\u0440\u0438\u0434\u0451\u0442.
    \u0422\u0430\u043A \u0432\u0441\u0435 \u0441\u0447\u0438\u0442\u0430\u044E\u0442.
    \u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C \u043D\u0438\u043A\u0442\u043E
    \u043D\u0435 \u0445\u043E\u0447\u0435\u0442.\n"
  type: 0
